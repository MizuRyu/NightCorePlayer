            "value": "レビューを書く"
          }
        }
      }
    },
    "On app launch, music will play at the configured playback speed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ起動時、設定した再生速度で音楽が再生されるようになります。"
          }
        }
      }
    },
    "※Recommended ×1.15 ~ ×1.25": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "※推奨 ×1.15 ~ ×1.25"
          }
        }
      }
    },
    "Failed to load terms.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
