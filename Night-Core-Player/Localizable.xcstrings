            "state": "translated",
            "value": "プレイリスト"
          }
        }
      }
    },
    "No displayable songs in this playlist": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプレイリストには表示できる曲がありません"
          }
        }
      }
    },
    "Play This Song": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この曲を再生"
          }
        }
      }
    },
    "Play Next": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に再生"
          }
        }
      }
    },
    "MusicKit Error: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicKit エラー: %@"
          }
        }
      }
    },
    "Playback Error: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生エラー: %@"
          }
        }
      }
    },
    "Data Save Error: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データ保存エラー: %@"
          }
        }
      }
    },
    "An Apple Music subscription is required to play.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生するには Apple Music のサブスクリプションが必要です"
          }
        }
      }
    },
    "MusicKit permission denied": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MusicKit の権限がありません"
          }
        }
      }
    },
    "Could not get songs from playlist \"%@\"": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイリスト「%@」の曲を取得できませんでした"
          }
        }
      }
    },
    "No displayable songs in playlist \"%@\"": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイリスト「%@」には表示できる曲がありません"
          }
        }
      }
    },
    "Could not get songs from playlist \"%@\": %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイリスト「%1$@」の曲を取得できませんでした: %2$@"
          }
        }
      }
    },
    "Pro": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro"
          }
        }
      }
    },
    "Pro Active": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 有効"
          }
        }
      }
    },
    "Unlock Pro": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro を購入"
          }
        }
      }
    },
    "Restore Purchases": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を復元"
          }
        }
      }
    },
    "Unlimited playback time": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生時間の制限なし"
          }
        }
      }
    },
    "Purchase pending approval": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入の承認待ちです"
          }
        }
      }
    },
    "Allowance exhausted": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高を使い切った状態にしました"
          }
        }
      }
    },
    "Allowance reset": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高の記録を消去しました"
          }
        }
      }
    },
    "Pro is not available right now. Please try again later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proを取得できませんでした。しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Today's Free Playback Time Is Used Up": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日の無料再生時間を使い切りました"
          }
        }
      }
    },
    "Normal-speed playback is still free": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "等倍再生は引き続き無料で再生頂けます。"
          }
        }
      }
    },
    "Add Playback Time": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生時間を追加"
          }
        }
      }
    },
    "Watch a video or go Pro to extend today's speed-control time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の視聴か Pro の購入で、今日の倍速再生の時間を増やせます。"
          }
        }
      }
    },
    "Adds playback time for today (%lld left today)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の再生時間を追加します（本日あと %lld 回）"
          }
        }
      }
    },
    "You've reached today's ad limit. It resets tomorrow.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日の視聴回数の上限に達しました。明日リセットされます。"
          }
        }
      }
    },
    "Switched Back to Normal Speed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "等倍速に戻しました"
          }
        }
      }
    },
    "Today's free playback time is used up. Add more time to speed up again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日の無料再生時間を使い切ったためです。時間を追加すると、また倍速で再生できます。"
          }
        }
      }
    },
    "Speed control has no time limit with Pro.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proのため、倍速再生の時間制限はありません。"
          }
        }
      }
    },
    "Unlimited speed control until %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ まで倍速再生を無制限でお使いいただけます。"
          }
        }
      }
    },
    "Normal speed is always free. The limit applies only to speed control, and resets daily.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "等倍速は常に無料です。時間制限は倍速再生にのみ掛かり、毎日リセットされます。"
          }
        }
      }
    },
    "Watch a Video": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画を見る"
          }
        }
      }
    },
    "+30 min": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+30分"
          }
        }
      }
    },
    "Adds playback time for today": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の再生時間を追加します"
          }
        }
      }
    },
    "Go Pro": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proにする"
          }
        }
      }
    },
    "One-time": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い切り"
          }
        }
      }
    },
    "Unlimited playback, no ads": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間制限なし・広告なしで使えます"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "You've watched 5 ads. Go Pro and you'll never need to again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告を5回視聴しました。本日の上限に達しました。Proなら永久再生可能◎"
          }
        }
      }
    },
    "Today's Remaining Playback Time": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日の残り再生時間"
          }
        }
      }
    },
    "Trial in Progress": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアル中"
          }
        }
      }
    },
    "Unlimited": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無制限"
          }
        }
      }
    },
    "+30 Minutes Added": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生時間を30分追加しました。"
          }
        }
      }
    },
    "Playback Time": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生時間"
          }
        }
      }
    }
  },
  "version": "1.0"
