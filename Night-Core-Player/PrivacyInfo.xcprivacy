<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- アプリ自身はトラッキング目的でデータを送る接続先を持たない。
	     AdMob の収集とトラッキングは GoogleMobileAds.framework 自身の
	     PrivacyInfo.xcprivacy が宣言する（SDK もトップレベルの NSPrivacyTracking は宣言していない）。
	     true にすると NSPrivacyTrackingDomains が1件以上必要になり、
	     Google は AdMob 用の正式なドメイン一覧を公開していないため申告できない（ITMS-91064）。 -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- アプリ自身が収集するものだけを宣言する。
	     CrashData / PerformanceData / DeviceID / AdvertisingData / ProductInteraction は
	     いずれも AdMob SDK 側が宣言済みのため、ここでは重複させない。 -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
