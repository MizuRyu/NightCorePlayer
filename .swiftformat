--swiftversion 5

--indent 4
--linebreaks lf

--importgrouping testable-bottom

# swiftlint(trailing_comma禁止)に合わせる
--commas inline

# redundantSelf: クロージャ内の明示selfを削るとcapture semanticsエラーになるため無効化
--disable wrapArguments,wrapMultilineStatementBraces,wrapMultilineFunctionChains,redundantSelf,noForceUnwrapInTests
